---
import AlertFeed from '../../components/alert/AlertFeed.svelte';
import ThemeBootstrap from '../../components/theme/ThemeBootstrap.astro';
import '../../styles/gara-theme.css';
import { instanceIdFor } from '../../garage/domain/tenant.js';

// Tenant de la sesion validada (fuera de produccion tambien admite ?instanceId=): nunca uno fijo.
const instanceId = instanceIdFor(Astro.request, Astro.locals);
---

<!DOCTYPE html>
<html lang="es" data-theme="taller">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alertas - GARA-G Gestión de flotas</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemeBootstrap />
  </head>
  <body class="swal-themed-page min-h-screen p-4 md:p-8">
    <div class="max-w-7xl mx-auto space-y-6">
      <header class="border-b pb-4 mb-6 flex flex-wrap justify-between items-center gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Alertas del sistema</h1>
          <p class="text-muted-foreground text-sm mt-1">
            Alertas en tiempo real de seguridad de flota, telemetría OBD-II y geocercas de la instancia: <code class="font-mono bg-muted px-1.5 py-0.5 rounded text-xs">{instanceId}</code>
          </p>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/fleet"
            class="px-4 py-2 text-sm font-semibold rounded bg-muted hover:bg-muted/80 text-foreground transition-colors"
          >
            ← Volver al panel de flota
          </a>
        </div>
      </header>

      <main>
        <AlertFeed client:only="svelte" instanceId={instanceId}>
          <div slot="fallback" style="min-height: 28rem" aria-hidden="true"></div>
        </AlertFeed>
      </main>
    </div>
  </body>
</html>

<style>
  /* Pagina heredada fuera de FleetLayout: toma fondo y texto del tema TALLER. */
  .swal-themed-page {
    background: var(--swal-bg);
    color: var(--swal-text);
    font-family: var(--swal-font);
  }
</style>
