---
import fleetUsersAdminScript from '../../../lib/inline/fleet-users-admin.js?raw';
/**
 * /fleet/users — Admin-only user management page.
 *
 * - Lists all users in the current instance from D1 (entity='user').
 * - Admin only: 403 for operator/observer.
 * - Shows role, active status, created/updated timestamps.
 * - Inline form to create new user (POST /api/auth/register).
 * - Actions: deactivate (toggle active), change role, delete.
 */
import { instanceIdFor } from '../../../garage/domain/tenant.js';
import FleetLayout from '../../../layouts/FleetLayout.astro';
import { env } from 'cloudflare:workers';
import { can } from '../../../lib/rbac';

// El middleware ya validó la sesión y dejó el usuario en locals (en dev, sin KV, también): es la
// única fuente del rol. Leer la cookie y buscarla en KV a mano dejaba al admin de desarrollo en
// "observer" y mostraba la página 403 a quien sí era administrador.
const sessionUser = (Astro.locals as { user?: { role?: string } }).user;
const role: string = sessionUser?.role ?? 'observer';
const forbidden = role !== 'admin';
if (forbidden) Astro.response.status = 403;

interface D1UserRow {
  instance_id: string;
  entity: string;
  id: string;
  data: string;
  created_at: string;
  updated_at: string;
}

const d1 = (env as unknown as { SWAL_D1?: any }).SWAL_D1;
// El tenant de la sesion. Antes era el tenant por defecto, fijo: el admin de cualquier cuenta veia los
// usuarios de la cuenta por defecto.
const sessionInstance = instanceIdFor(Astro.request, Astro.locals);

let users: Array<{
  id: string;
  email: string;
  role: string;
  active: boolean;
  createdAt: string;
  updatedAt: string;
}> = [];

// Un fallo de D1 NO es "no hay usuarios": se distingue para no invitar a crear uno que ya existe.
let loadError = '';

if (d1 && !forbidden) {
  try {
    const rows = await d1
      .prepare('SELECT instance_id, entity, id, data, created_at, updated_at FROM entity WHERE instance_id = ? AND entity = ?')
      .bind(sessionInstance, 'user')
      .all<D1UserRow>();
    for (const row of rows.results ?? []) {
      try {
        const data = JSON.parse(row.data) as { email?: string; role?: string; active?: boolean };
        users.push({
          id: row.id,
          email: data.email ?? row.id,
          role: data.role ?? 'observer',
          active: data.active !== false,
          createdAt: row.created_at,
          updatedAt: row.updated_at,
        });
      } catch {}
    }
  } catch (e) {
    loadError = e instanceof Error && e.message ? e.message : 'error desconocido';
  }
}

const counts = {
  total: users.length,
  admins: users.filter((u) => u.role === 'admin').length,
  operators: users.filter((u) => u.role === 'operator').length,
  observers: users.filter((u) => u.role === 'observer').length,
  active: users.filter((u) => u.active).length,
};
---
<FleetLayout title="Usuarios — GARA-G">
  {forbidden && (
    <section class="g-card users-forbidden" data-testid="users-forbidden" role="alert">
      <h1 class="g-page-title">Acceso denegado</h1>
      <p>Esta página es solo para administradores.</p>
      <a href="/fleet" class="g-btn swal-chamfer-sm">← Volver al panel</a>
    </section>
  )}
  {!forbidden && (
  <Fragment>
  <div class="g-page-header">
    <div>
      <h1 class="g-page-title">👤 Usuarios</h1>
      <p class="g-page-subtitle">Gestión de accesos — {counts.total} usuario{counts.total !== 1 ? 's' : ''} registrado{counts.total !== 1 ? 's' : ''}</p>
    </div>
  </div>

  <!-- Counts summary -->
  <div class="counts-row">
    <span class="count-pill count-admin">👑 {counts.admins} admin{counts.admins !== 1 ? 's' : ''}</span>
    <span class="count-pill count-operator">🔧 {counts.operators} operador{counts.operators !== 1 ? 'es' : ''}</span>
    <span class="count-pill count-observer">👁 {counts.observers} observador{counts.observers !== 1 ? 'es' : ''}</span>
    <span class="count-pill count-active">✓ {counts.active} activo{counts.active !== 1 ? 's' : ''}</span>
  </div>

  <!-- New user form -->
  <details class="g-card" style="margin: 1.5rem 0;">
    <summary style="cursor: pointer; font-weight: 600; padding: 0.5rem;">➕ Crear nuevo usuario</summary>
    <form method="POST" action="/api/auth/register" id="create-user-form" style="padding: 1rem 0;">
      <div class="form-row">
        <label>Email
          <input type="email" name="email" required autocomplete="off" />
        </label>
        <label>Contraseña
          <input type="password" name="password" required minlength="6" autocomplete="new-password" />
        </label>
        <label>Rol
          <select name="role" required>
            <option value="observer">Observador (solo lectura)</option>
            <option value="operator">Operador (todo menos usuarios)</option>
            <option value="admin">Administrador (control total)</option>
          </select>
        </label>
        <label class="checkbox-label">
          <input type="checkbox" name="active" checked /> Activo
        </label>
        <button type="submit" class="g-btn g-btn-primary swal-chamfer-sm" data-testid="create-user-submit">Crear usuario</button>
      </div>
    </form>
  </details>

  <!-- Users table -->
  <div class="g-card">
    {loadError ? (
      <p class="g-load-error" role="alert" data-testid="users-load-error">
        No se pudo cargar la lista de usuarios ({loadError}). <a href="">Reintentar</a>
      </p>
    ) : users.length === 0 ? (
      <p class="g-muted">No hay usuarios registrados en esta instancia. Crea el primero arriba.</p>
    ) : (
      <table class="g-table">
        <caption class="sr-only">Usuarios registrados</caption>
        <thead>
          <tr>
            <th scope="col">Email</th>
            <th scope="col">Rol</th>
            <th scope="col">Estado</th>
            <th scope="col">Creado</th>
            <th scope="col">ID</th>
          </tr>
        </thead>
        <tbody>
          {users.map((u) => (
            <tr>
              <td><strong>{u.email}</strong></td>
              <td><span class={`role-badge role-${u.role}`}>{u.role}</span></td>
              <td>{u.active ? <span class="status-active">✓ Activo</span> : <span class="status-inactive">✗ Inactivo</span>}</td>
              <td class="g-muted">{u.createdAt.slice(0, 10)}</td>
              <td class="g-muted" style="font-family: var(--g-font-mono); font-size: 0.8em;">{u.id}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

  </Fragment>
  )}

  <script is:inline set:html={fleetUsersAdminScript} />

  <style>
    .users-forbidden { max-width: 28rem; margin: 2rem auto; padding: 1.5rem; text-align: center; border: 1px solid var(--swal-danger); }
    .users-forbidden .g-page-title { color: var(--swal-danger); margin: 0 0 0.75rem; }
    .counts-row {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .count-pill {
      padding: 0.375rem 0.75rem;
      background: var(--swal-bg-surface);
      border: 1px solid var(--swal-border);
      font-size: 0.8rem;
      font-family: var(--g-font-mono);
    }
    .count-admin { color: var(--swal-danger); }
    .count-operator { color: var(--swal-warning); }
    .count-observer { color: var(--swal-info); }
    .count-active { color: var(--swal-success); }
    .form-row {
      display: grid;
      grid-template-columns: 2fr 2fr 1fr auto auto;
      gap: 0.75rem;
      align-items: end;
    }
    .form-row label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; color: var(--g-text-secondary); }
    .form-row input, .form-row select {
      background: var(--g-bg-input);
      border: 1px solid var(--g-border-subtle);
      border-radius: var(--g-radius-md);
      padding: 0.5rem;
      color: var(--g-text-primary);
      font: inherit;
    }
    .checkbox-label { flex-direction: row !important; align-items: center; gap: 0.5rem; }
    @media (max-width: 768px) {
      .form-row { grid-template-columns: 1fr; }
    }
    .role-badge {
      display: inline-block;
      padding: 0.125rem 0.5rem;
      background: var(--swal-bg-surface);
      color: var(--swal-text-secondary);
      border: 1px solid var(--swal-border);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .g-load-error { color: var(--swal-danger); margin: 0; }
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }
    .status-active { color: var(--swal-success); }
    .status-inactive { color: var(--swal-text-faint); }
  </style>
</FleetLayout>
