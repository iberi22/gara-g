---
import FleetLayout from '../../layouts/FleetLayout.astro';
import GenericTable from '../../components/GenericTableAstro.astro';
import PageHeader from '../../components/PageHeader.astro';
import { ensureSeedData, DEMO_INSTANCE_ID } from '../../lib/fleetSeed.js';
import { listEntities } from '../../lib/domain.js';
import { instanceIdFor } from '../../garage/domain/tenant.js';

// Tenant de la sesion (fuera de produccion tambien admite ?instanceId=).
// La semilla solo se escribe para el tenant demo.
const instanceId = instanceIdFor(Astro.request, Astro.locals);
if (instanceId === DEMO_INSTANCE_ID) await ensureSeedData();
const fleets = await listEntities('fleet', instanceId);
const vehicles = await listEntities('vehicle', instanceId);

const fleetStats = fleets.map((f: any) => ({
  ...f,
  vehicleCount: vehicles.filter((v: any) => v.fleetId === f.id).length,
  activeCount: vehicles.filter((v: any) => v.fleetId === f.id && v.status === 'active').length,
}));

const columns = [
  { key: 'name', label: 'Nombre' },
  { key: 'region', label: 'Región' },
  { key: 'vehicleCount', label: 'Vehículos' },
  { key: 'activeCount', label: 'Activos' },
  { key: 'managerId', label: 'Manager' },
];
---

<FleetLayout title="Flotas" section="fleets">
  <section data-testid="fleets-page">
    <PageHeader title="Flotas" subtitle="Gestión de flotas de la organización" icon="fleets" />
    <GenericTable columns={columns} rows={fleetStats} testId="fleets-table" />
  </section>
</FleetLayout>
