---
/**
 * pages/fleet/vehicles/index.astro — Listado de vehículos con acciones CRUD.
 *
 * El tenant sale de la sesión (fuera de produccion tambien de ?instanceId=).
 * GET ?deleted=… → toast de confirmación si se eliminó
 */
import { vehicleFormFields } from '../../../lib/vehicleForm';
import FleetLayout from '../../../layouts/FleetLayout.astro';
import GenericTable from '../../../components/GenericTableAstro.astro';
import EntityForm from '../../../components/EntityForm.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { ensureSeedData, DEMO_INSTANCE_ID } from '../../../lib/fleetSeed.js';
import { listEntities } from '../../../lib/domain.js';
import { instanceIdFor } from '../../../garage/domain/tenant.js';
import { MARKET, localizeText } from '../../../lib/market.js';
import { vehicleTypeLabel } from '../../../lib/vehicleCatalog.js';

// Tenant de la sesion (fuera de produccion tambien admite ?instanceId=).
// La semilla solo se escribe para el tenant demo.
const instanceId = instanceIdFor(Astro.request, Astro.locals);
if (instanceId === DEMO_INSTANCE_ID) await ensureSeedData();

const url = Astro.url;
const deletedId = url.searchParams.get('deleted');
const vehicles = await listEntities('vehicle', instanceId);
const fleets = await listEntities('fleet', instanceId);
const fleetOptions = (fleets as any[]).map((f: any) => ({
  value: f.id,
  label: f.name ?? f.id,
}));

const columns = [
  { key: 'plate', label: MARKET.vehicleIdLabel, width: '7rem' },
  { key: 'make', label: 'Marca' },
  { key: 'modelLabel', label: 'Modelo' },
  { key: 'year', label: 'Año', width: '5rem', align: 'center' as const },
  { key: 'typeLabel', label: 'Tipo' },
  { key: 'capacity', label: 'Capacidad', width: '7rem' },
];

// El `type` guardado ('volqueta') y el nombre de modelo del fabricante ('T800 Volqueta') se
// muestran en el vocabulario del mercado: la tabla era otra de las pantallas con "volqueta"
// en un entregable chileno. Las claves crudas no se tocan (el formulario y la API las usan).
const rows = (vehicles as any[]).map((v) => ({
  ...v,
  modelLabel: localizeText(String(v.model ?? ''), MARKET),
  typeLabel: vehicleTypeLabel(v.type, MARKET),
}));

const vehicleFields = vehicleFormFields(fleetOptions);
---

<FleetLayout title="Vehículos" section="vehicles">
  <section data-testid="vehicles-page">
    <PageHeader title="Vehículos" subtitle={`${vehicles.length} unidades`} icon="vehicles" />

    {deletedId && (
      <div class="g-toast g-toast-success" role="alert">
        ✅ Registro eliminado correctamente.
        <a href="?" class="g-toast-dismiss">✕</a>
      </div>
    )}

    <!-- Form crear nuevo (expandible) -->
    <details class="g-create-form">
      <summary class="g-create-toggle">
        <span>➕ Agregar vehículo</span>
      </summary>
      <div class="g-create-content">
        <EntityForm
          entity="vehicle"
          instanceId={instanceId}
          fields={vehicleFields}
          cancelUrl="/fleet/vehicles"
        />
      </div>
    </details>

    <!-- Tabla con acciones -->
    <GenericTable
      columns={columns}
      rows={rows}
      testId="vehicles-table"
      showActions={true}
      editBase={`/fleet/vehicles/edit`}
      entity="vehicle"
      instanceId={instanceId}
    />
  </section>
</FleetLayout>

<style>
  .g-toast {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  .g-toast-success {
    background: var(--swal-success-muted);
    border: 1px solid var(--swal-success);
    color: var(--swal-success);
  }
  .g-toast-dismiss {
    color: inherit;
    text-decoration: none;
    font-size: 1rem;
    opacity: 0.7;
  }

  .g-create-form {
    margin-bottom: 1rem;
    background: var(--g-bg-elevated);
    border: 1px solid var(--g-border-accent);
    border-radius: 0.5rem;
  }
  .g-create-toggle {
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--g-accent-primary);
    user-select: none;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .g-create-toggle:hover { opacity: 0.8; }
  .g-create-content { padding: 1rem 1rem 1.5rem; }

  @media (max-width: 768px) {
    .g-create-form { margin: 0 0.5rem 1rem; }
  }
</style>
