---
/**
 * pages/fleet/notifications/index.astro — Centro de notificaciones (P1.2).
 *
 * Lista notificaciones de la instancia (más nuevas primero), con filtro
 * ?filter=unread y acción "Marcar leída" (PATCH /api/fleet/notification?id=).
 */
import FleetLayout from '../../../layouts/FleetLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { ensureSeedData, DEMO_INSTANCE_ID } from '../../../lib/fleetSeed.js';
import { listEntities } from '../../../lib/domain.js';
import { unreadOnly, sortNewestFirst, unreadCount } from '../../../lib/notifications.js';
import { instanceIdFor } from '../../../garage/domain/tenant.js';
import { notificationTitleLabel, severityLabel } from '../../../lib/alertLabels';

// Tenant de la sesion (fuera de produccion tambien admite ?instanceId=).
// La semilla solo se escribe para el tenant demo.
const instanceId = instanceIdFor(Astro.request, Astro.locals);
if (instanceId === DEMO_INSTANCE_ID) await ensureSeedData();

const url = Astro.url;
const onlyUnread = url.searchParams.get('filter') === 'unread';
const markedId = url.searchParams.get('marked');

const all = sortNewestFirst(
  (await listEntities('notification', instanceId)) as any[],
);
const rows = onlyUnread ? unreadOnly(all) : all;
const unread = unreadCount(all);
---

<FleetLayout title="Notificaciones" section="notifications">
  <section data-testid="notifications-page">
    <PageHeader
      title="Notificaciones"
      subtitle={`${unread} sin leer de ${all.length}`}
      icon="alerts"
    />

    {markedId && (
      <div class="g-toast g-toast-success" role="status" aria-live="polite">✅ Notificación marcada como leída.</div>
    )}

    <nav class="g-notif-filter">
      <a href="/fleet/notifications" data-testid="filter-all">Todas</a>
      <a href="/fleet/notifications?filter=unread" data-testid="filter-unread">
        Sin leer ({unread})
      </a>
    </nav>

    {rows.length === 0 ? (
      <p class="g-notif-empty" data-testid="notif-empty">Sin notificaciones.</p>
    ) : (
      <ul class="g-notif-list">
        {rows.map((n: any) => (
          <li
            data-testid="notif-row"
            data-read={n.readAt ? 'true' : 'false'}
            class:list={['g-notif-row', !n.readAt && 'g-notif-unread']}
          >
            <span class="g-notif-kind swal-kicker">
              {!n.readAt && <span class="swal-tick" style="margin-right: 4px;"></span>}
              {n.kind === 'alert' ? 'ALERTA' : n.kind}
            </span>
            <div class="g-notif-body">
              <strong>{notificationTitleLabel(n.title)}</strong>
              <p>{n.body}</p>
              <small>{n.createdAt ? new Date(n.createdAt).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' }) : ''}{n.severity ? ` · ${severityLabel(n.severity)}` : ''}</small>
            </div>
            {!n.readAt && (
              <button
                data-testid="notif-mark-read"
                data-id={n.id}
                data-instance={instanceId}
                class="g-notif-mark"
                aria-label={`Marcar como leída la notificación: ${notificationTitleLabel(n.title)}`}
              >
                Marcar leída
              </button>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>
</FleetLayout>

<script>
  // SPA-safe (ViewTransitions): re-vincula en cada astro:page-load (guard por botón).
  function initNotifButtons() {
  document.querySelectorAll('[data-testid="notif-mark-read"]:not([data-bound])').forEach((btn) => {
    (btn as HTMLElement).dataset.bound = '1';
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      const id = el.dataset.id!;
      const instanceId = el.dataset.instance!;
      const res = await fetch(
        `/api/fleet/notification?id=${encodeURIComponent(id)}&instanceId=${encodeURIComponent(instanceId)}`,
        {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ readAt: new Date().toISOString() }),
        },
      );
      if (res.ok) {
        window.location.href = `/fleet/notifications?marked=${encodeURIComponent(id)}`;
      }
    });
  });
  } // initNotifButtons
  document.addEventListener('astro:page-load', initNotifButtons);
  initNotifButtons();
</script>

<style>
.g-toast { padding: 0.75rem 1rem; border-radius: 0.375rem; margin-bottom: 1rem; font-size: 0.875rem; }
.g-toast-success { background: var(--swal-success-muted); border: 1px solid color-mix(in srgb, var(--swal-success) 40%, transparent); color: var(--swal-success); }
.g-notif-filter { display: flex; gap: 1rem; margin-bottom: 1rem; font-size: 0.875rem; }
.g-notif-filter a { color: var(--swal-accent-text); }
.g-notif-empty { color: var(--swal-text-muted); }
.g-notif-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.g-notif-row { display: flex; gap: 0.75rem; align-items: flex-start; background: var(--swal-bg-elevated); border: 1px solid var(--swal-border); border-radius: 0.5rem; padding: 0.75rem 1rem; }
.g-notif-unread { border-color: var(--swal-border); }
.g-notif-kind { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: var(--swal-text-faint); padding-top: 0.2rem; display: flex; align-items: center; }
.g-notif-body { flex: 1; color: var(--swal-text); font-size: 0.875rem; }
.g-notif-body p { margin: 0.25rem 0; color: var(--swal-text-secondary); }
.g-notif-body small { color: var(--swal-text-muted); }
.g-notif-mark { background: transparent; border: 1px solid var(--swal-border); color: var(--swal-text-secondary); border-radius: 0.375rem; padding: 0.25rem 0.75rem; cursor: pointer; font-size: 0.8rem; }
.g-notif-mark:hover { background: var(--swal-hover-bg); border-color: var(--swal-border-strong); color: var(--swal-text); }
.notif-bell { position: relative; font-size: 1.25rem; text-decoration: none; margin-right: 0.5rem; }
.notif-badge { position: absolute; top: -6px; right: -8px; background: var(--swal-danger); color: var(--swal-on-danger); font-size: 0.65rem; font-weight: 700; border-radius: 9999px; padding: 0 0.35rem; line-height: 1.2rem; }
</style>
