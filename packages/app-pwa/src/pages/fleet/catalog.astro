---
/**
 * /fleet/catalog — Buscador del catálogo vehicular (BD local).
 * Pre-renderizado a HTML estático para Pages + offline (Service Worker).
 */

import FleetLayout from '../../layouts/FleetLayout.astro';
import FleetIcon from '../../components/FleetIcon.astro';
import {
  VEHICLE_CATALOG,
  getAllMakes,
  getModelsForMake,
  type VehicleModel,
} from '../../lib/vehicleCatalog.js';
import { MARKET, documentKindLabel, formatMoney, formatNumber } from '../../lib/market.js';

// Los nombres de los documentos obligatorios salen del mercado: en Chile el campo guardado
// como 'SOAT' se muestra "SOAP" y 'Tecnomecánica' como "Revisión Técnica (PRT)".
const SOAP_LABEL = documentKindLabel('SOAT', MARKET);
const RT_LABEL = documentKindLabel('Tecnomecánica', MARKET);

// Serializar para uso en cliente (script de abajo)
const catalogJson = JSON.stringify(VEHICLE_CATALOG);

const allMakes = getAllMakes();
const totalModels = VEHICLE_CATALOG.reduce((acc, m) => acc + m.models.length, 0);
const totalRepuestos = VEHICLE_CATALOG.reduce(
  (acc, m) => acc + m.models.reduce((a, md) => a + md.commonParts.length, 0),
  0,
);
---

<FleetLayout title="Catálogo Vehicular" section="fleets">
  <section data-testid="catalog-page">
    <div class="g-page-header" data-testid="page-header">
      <div class="g-page-header-left">
        <span class="g-page-icon" aria-hidden="true">
          <FleetIcon name="search" size={22} />
        </span>
        <div class="g-page-titles">
          <h2 class="g-page-title">Base de Datos Vehicular</h2>
          <p class="g-page-subtitle">Marcas, modelos y repuestos comunes para flota LATAM</p>
        </div>
      </div>
      <div class="g-catalog-stats">
        <span class="g-pill">
          <FleetIcon name="vehicles" size={12} />
          <span><strong>{allMakes.length}</strong> marcas</span>
        </span>
        <span class="g-pill g-pill-cyan">
          <FleetIcon name="dashboard" size={12} />
          <span><strong>{totalModels}</strong> modelos</span>
        </span>
        <span class="g-pill g-pill-orange">
          <FleetIcon name="maintenance" size={12} />
          <span><strong>{totalRepuestos}</strong> repuestos</span>
        </span>
      </div>
    </div>

    <div class="g-search-bar">
      <FleetIcon name="search" size={16} />
      <input
        type="search"
        id="catalog-search"
        placeholder="Buscar marca o modelo (ej. Hilux, NPR, FH16)..."
        data-testid="catalog-search"
        class="g-search-input"
      />
    </div>

    <!-- Resultados -->
    <div id="catalog-results" data-testid="catalog-results">
      {VEHICLE_CATALOG.map((make) => (
        <section class="make-block" data-make={make.name}>
          <header class="make-header">
            <h3 class="make-name">{make.name}</h3>
            <span class="make-origin">{make.countryOrigin}</span>
            <span class="make-count">{make.models.length} modelos</span>
          </header>
          {make.models.map((model) => (
            <article class="model-card swal-card-frame" data-model={`${make.name} ${model.model}`}>
              <div class="swal-card-inner">
              <header class="model-header">
                <div class="model-title-row">
                  <h4 class="model-name">{model.model}</h4>
                  <span class="model-type"><span class="swal-tick"></span>{model.type}</span>
                </div>
                <div class="model-specs">
                  <span><strong>{model.yearsAvailable.join(', ')}</strong> fab.</span>
                  <span><strong>{model.fuelType}</strong></span>
                  <span><strong>{model.engineCC}cc</strong></span>
                  <span><strong>{model.powerHP} HP</strong></span>
                  {model.payloadKg && (
                    <span><strong>{formatNumber(model.payloadKg, MARKET)} kg</strong> carga</span>
                  )}
                </div>
              </header>

              <div class="model-cost">
                <div class="cost-item">
                  <span class="cost-label">{SOAP_LABEL} anual est.</span>
                  <span class="cost-value">{formatMoney(model.soatDefaultCOP, MARKET)}</span>
                </div>
                <div class="cost-item">
                  <span class="cost-label">{RT_LABEL}</span>
                  <span class="cost-value">{formatMoney(model.tecnoManualCOP, MARKET)}</span>
                </div>
                <div class="cost-item">
                  <span class="cost-label">Revisión cada</span>
                  <span class="cost-value">{formatNumber(model.revisionPeriodKm, MARKET)} km</span>
                </div>
                <div class="cost-item">
                  <span class="cost-label">Cambio aceite</span>
                  <span class="cost-value">{formatNumber(model.oilChangeKm, MARKET)} km</span>
                </div>
              </div>

              <details class="parts-disclosure">
                <summary class="parts-summary">
                  <FleetIcon name="maintenance" size={14} />
                  <span>{model.commonParts.length} repuestos comunes</span>
                  <FleetIcon name="chevronDown" size={14} />
                </summary>
                <div class="parts-table g-table-wrap g-table-scroll" role="region" aria-label="Repuestos comunes" tabindex="0">
                  <table class="g-table">
                    <thead>
                      <tr>
                        <th>Repuesto</th>
                        <th>Categoría</th>
                        <th>Vida útil</th>
                        <th>Costo prom.</th>
                      </tr>
                    </thead>
                    <tbody>
                      {model.commonParts.map((part) => (
                        <tr>
                          <td>{part.name}</td>
                          <td><span class="part-cat">{part.category}</span></td>
                          <td>{formatNumber(part.lifeKm, MARKET)} km</td>
                          <td>{formatMoney(part.avgCostCOP, MARKET)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            </div>
            </article>
          ))}
        </section>
      ))}
    </div>

    <!-- Calculadora de próximo servicio -->
    <section class="calculator" data-testid="catalog-calculator">
      <h3 class="calc-title">Calculadora de próximo servicio</h3>
      <p class="calc-sub">Ingresa el kilometraje actual de un vehículo para estimar cuándo toca mantenimiento.</p>
      <form class="calc-form" id="calc-form" data-testid="calc-form">
        <div class="form-row">
          <label class="form-label">
            <span>Marca</span>
            <select id="calc-make" data-testid="calc-make" class="form-select">
              {allMakes.map((m) => <option value={m}>{m}</option>)}
            </select>
          </label>
          <label class="form-label">
            <span>Modelo</span>
            <select id="calc-model" data-testid="calc-model" class="form-select">
              {getModelsForMake(allMakes[0]).map((md) => <option value={md}>{md}</option>)}
            </select>
          </label>
          <label class="form-label">
            <span>Kilometraje actual</span>
            <input
              type="number"
              id="calc-km"
              data-testid="calc-km"
              placeholder="ej. 45000"
              min="0"
              class="form-input"
            />
          </label>
        </div>
        <div id="calc-result" data-testid="calc-result" class="calc-result"></div>
      </form>
    </section>
  </section>
</FleetLayout>

<style>
  .g-catalog-stats {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .g-catalog-stats .g-pill {
    font-size: 0.6875rem;
  }
  .g-catalog-stats strong {
    color: inherit;
  }

  .g-search-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: var(--g-bg-surface);
    border: 1px solid var(--g-border-subtle);
    border-radius: var(--g-radius-lg);
    margin-bottom: 1.5rem;
  }
  .g-search-bar:focus-within {
    border-color: var(--swal-accent);
  }
  .g-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--g-text-primary);
    font-size: 0.875rem;
    font-family: inherit;
  }

  .make-block {
    margin-bottom: 2rem;
  }
  .make-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--swal-border-strong);
    margin-bottom: 0.75rem;
  }
  .make-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--swal-accent-text);
    margin: 0;
  }
  .make-origin {
    font-size: 0.6875rem;
    color: var(--swal-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .make-count {
    font-size: 0.6875rem;
    color: var(--swal-text-muted);
    margin-left: auto;
  }

  .model-card {
    margin-bottom: 0.625rem;
    overflow: hidden;
  }
  .model-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--swal-border);
  }
  .model-title-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
  }
  .model-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--swal-text);
    margin: 0;
  }
  .model-type {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--swal-font-mono);
    font-size: 0.625rem;
    padding: 0.1875rem 0.5rem;
    background: var(--swal-bg-surface);
    color: var(--swal-text-secondary);
    border: 1px solid var(--swal-border);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  .model-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--swal-text-muted);
  }
  .model-specs strong {
    color: var(--swal-text-secondary);
    font-weight: 500;
    text-transform: capitalize;
  }

  .model-cost {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    background: var(--swal-hover-bg);
  }
  .cost-item {
    display: flex;
    flex-direction: column;
  }
  .cost-label {
    font-size: 0.625rem;
    color: var(--swal-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .cost-value {
    font-size: 0.875rem;
    color: var(--swal-accent-text);
    font-weight: 600;
  }

  .parts-disclosure {
    border-top: 1px solid var(--swal-border);
  }
  .parts-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    cursor: pointer;
    color: var(--swal-text-faint);
    font-size: 0.8125rem;
    list-style: none;
  }
  .parts-summary::-webkit-details-marker {
    display: none;
  }
  .parts-summary:hover {
    background: var(--swal-hover-bg);
    color: var(--swal-text);
  }
  .parts-summary :global(svg:last-child) {
    margin-left: auto;
  }

  .part-cat {
    display: inline-block;
    padding: 0.125rem 0.437rem;
    border-radius: 3px;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--swal-bg-surface);
    color: var(--swal-text-secondary);
  }

  /* Calculadora */
  .calculator {
    margin-top: 1.5rem;
    padding: 1.25rem;
    background: var(--swal-surface);
    border: 1px solid var(--swal-border);
    border-radius: 12px;
  }
  .calc-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--swal-text);
    margin: 0 0 0.25rem;
  }
  .calc-sub {
    font-size: 0.8125rem;
    color: var(--swal-text-faint);
    margin: 0 0 1rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: 0.75rem;
  }
  .form-label {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--swal-text-faint);
  }
  .form-select, .form-input {
    background: var(--swal-bg-elevated);
    border: 1px solid var(--swal-border-strong);
    border-radius: 6px;
    padding: 0.5rem 0.625rem;
    color: var(--swal-text);
    font-size: 0.875rem;
    font-family: inherit;
    min-width: 0;
    width: 100%;
  }
  .form-select:focus, .form-input:focus {
    outline: none;
    border-color: var(--swal-accent);
  }
  .calc-result {
    margin-top: 1rem;
    padding: 0.875rem;
    background: var(--swal-active-bg);
    border: 1px solid var(--swal-accent);
    border-radius: 6px;
    color: var(--swal-text);
    font-size: 0.8125rem;
    display: none;
  }
  .calc-result.active {
    display: block;
  }
  .calc-result.overdue {
    background: var(--swal-danger-bg);
    border-color: var(--swal-danger);
  }
  .calc-result :global(.calc-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr));
    gap: 0.625rem;
  }

  /* === Responsive === */
  @media (max-width: 768px) {
    .g-catalog-stats { width: 100%; flex-wrap: wrap; }
    .model-cost { grid-template-columns: repeat(2, 1fr); }
    .form-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .g-page-title { font-size: 1.375rem; }
    .model-cost { grid-template-columns: 1fr; }
    .model-specs { font-size: 0.6875rem; gap: 0.625rem; }

    .calculator { padding: 1rem; }
  }
</style>

<script lang="ts" define:vars={{ catalogJson, marketLocale: MARKET.locale, soapLabel: SOAP_LABEL, rtLabel: RT_LABEL }}>
  // SPA-safe (ViewTransitions): re-vincula en cada astro:page-load.
  // Guard por elemento (no global: al volver por SPA el DOM es nuevo).
  function initCatalog() {
    const searchInput = document.getElementById('catalog-search');
    if (!searchInput || searchInput.dataset.bound) return;
    searchInput.dataset.bound = '1';
  const results = document.getElementById('catalog-results');
  if (searchInput && results) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      const makes = results.querySelectorAll('.make-block');
      makes.forEach((make) => {
        let visible = 0;
        make.querySelectorAll('.model-card').forEach((card) => {
          const match = card.dataset.model?.toLowerCase().includes(q) || make.dataset.make?.toLowerCase().includes(q);
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        make.style.display = visible > 0 || q === '' ? '' : 'none';
      });
    });
  }

  // Calculadora de próximo servicio
  const calcMake = document.getElementById('calc-make');
  const calcModel = document.getElementById('calc-model');
  const calcKm = document.getElementById('calc-km');
  const calcResult = document.getElementById('calc-result');

  // Hydrate model options from server-rendered data via JSON
  // catalogJson viene serializado en el frontmatter e inyectado vía define:vars
  const catalogData = JSON.parse(catalogJson);

  if (calcMake && calcModel && calcKm && calcResult) {
    function updateModels() {
      const make = calcMake.value;
      const found = catalogData.find((m) => m.name === make);
      calcModel.innerHTML = found ? found.models.map((md) => `<option value="${md.model}">${md.model}</option>`).join('') : '';
      updateResult();
    }

    function updateResult() {
      const km = parseInt(calcKm.value || '0', 10);
      if (!km || km <= 0) {
        calcResult.className = 'calc-result';
        calcResult.textContent = '';
        return;
      }
      const make = calcMake.value;
      const model = calcModel.value;
      const found = catalogData.find((m) => m.name === make);
      const md = found?.models.find((md) => md.model === model);
      if (!md) return;

      const nextRev = Math.ceil(km / md.revisionPeriodKm) * md.revisionPeriodKm + md.revisionPeriodKm;
      const remainingRev = nextRev - km;
      const nextOil = Math.ceil(km / md.oilChangeKm) * md.oilChangeKm + md.oilChangeKm;
      const remainingOil = nextOil - km;
      const soat = md.soatDefaultCOP;
      const tecno = md.tecnoManualCOP;

      calcResult.className = remainingRev < 0 || remainingOil < 0 ? 'calc-result active overdue' : 'calc-result active';
      // Formato con el locale del mercado (es-CL) y los nombres de documento del mercado.
      const num = (n) => n.toLocaleString(marketLocale);
      const money = (n) => `$${n.toLocaleString(marketLocale)}`;
      calcResult.innerHTML = `
        <div class="calc-grid">
          <div><strong>Próxima revisión:</strong> <span style="color: var(--swal-accent-text)">${num(nextRev)} km</span>
            <br/><small style="color: var(--swal-text-faint)">${remainingRev < 0 ? `⚠️ VENCIDO hace ${num(Math.abs(remainingRev))} km` : `faltan ${num(remainingRev)} km`}</small></div>
          <div><strong>Próx. cambio aceite:</strong> <span style="color: var(--swal-accent-text)">${num(nextOil)} km</span>
            <br/><small style="color: var(--swal-text-faint)">${remainingOil < 0 ? `⚠️ VENCIDO hace ${num(Math.abs(remainingOil))} km` : `faltan ${num(remainingOil)} km`}</small></div>
          <div><strong>${soapLabel} est.:</strong> <span style="color: var(--swal-accent-text)">${money(soat)}</span></div>
          <div><strong>${rtLabel}:</strong> <span style="color: var(--swal-accent-text)">${money(tecno)}</span></div>
        </div>
      `;
    }

    calcMake.addEventListener('change', updateModels);
    calcKm.addEventListener('input', updateResult);
    updateResult();
  }
  } // initCatalog
  document.addEventListener('astro:page-load', initCatalog);
  initCatalog();
</script>