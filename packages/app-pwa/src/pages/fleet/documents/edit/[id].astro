---
/**
 * pages/fleet/documents/edit/[id].astro — Editar un documento existente.
 */
import FleetLayout from '../../../../layouts/FleetLayout.astro';
import EntityForm from '../../../../components/EntityForm.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import { ensureSeedData, DEMO_INSTANCE_ID } from '../../../../lib/fleetSeed.js';
import { getEntity, listEntities } from '../../../../lib/domain.js';
import { instanceIdFor } from '../../../../garage/domain/tenant.js';

// Tenant de la sesion (fuera de produccion tambien admite ?instanceId=).
// La semilla solo se escribe para el tenant demo.
const instanceId = instanceIdFor(Astro.request, Astro.locals);
if (instanceId === DEMO_INSTANCE_ID) await ensureSeedData().catch(() => {});

const vehicles = await listEntities('vehicle', instanceId).catch(() => [] as any[]);
const vehicleOptions = vehicles.map((v: any) => ({ value: v.id, label: `${v.plate || v.name || v.vin || 'Sin placa'} — ${v.make ?? ''} ${v.model ?? ''}`.trim() }));

const url = Astro.url;
const id = url.pathname.split('/').pop()!;

let doc: any = null;
try {
  doc = await getEntity('document', id, instanceId);
  if (!doc) {
    const all = await listEntities('document', instanceId);
    doc = all.find((d: any) => d.id === id) ?? null;
  }
} catch (e: any) {
  console.error('[document/edit] getEntity error:', e?.message);
  doc = null;
}

if (!doc) {
  return Astro.redirect('/fleet/documents?error=not_found');
}

const documentFields = [
  { name: 'vehicleId', label: 'Vehículo', type: 'select', required: true, options: vehicleOptions },
  { name: 'kind', label: 'Tipo de documento', type: 'text', required: true },
  { name: 'r2Key', label: 'R2 key', type: 'text' },
  { name: 'expiry', label: 'Fecha de vencimiento', type: 'date' },
  {
    name: 'status', label: 'Estado', type: 'select',
    options: [
      { value: 'valid', label: 'Válido' },
      { value: 'expiring', label: 'Por vencer' },
      { value: 'expired', label: 'Vencido' },
    ],
  },
];
---

<FleetLayout title={`Editar documento`} section="documents">
  <section data-testid="document-edit-page">
    <PageHeader
      title={`Editar documento: ${doc.kind}`}
      subtitle={`Vehículo ${(vehicles as any[]).find((v) => v.id === doc.vehicleId)?.plate ?? 'sin placa'}`}
      icon="documents"
    />

    {url.searchParams.get('error') === 'not_found' && (
      <div class="g-toast g-toast-error">❌ Documento no encontrado.</div>
    )}

    <EntityForm
      entity="document"
      instanceId={instanceId}
      initialData={doc}
      fields={documentFields}
      cancelUrl="/fleet/documents"
    />

    {doc.r2Key && (
      <div class="doc-preview">
        <a href={`/r2/${doc.r2Key}`} target="_blank" rel="noopener" class="doc-link">
          📄 Ver archivo en R2
        </a>
      </div>
    )}
  </section>
</FleetLayout>

<style>
    .g-toast { padding: 0.75rem 1rem; border-radius: 0; margin-bottom: 1rem; font-size: 0.875rem; }
  .g-toast-error {
    background: var(--swal-danger-bg);
    border: 1px solid color-mix(in srgb, var(--swal-danger) 40%, transparent);
    color: var(--swal-danger);
  }
  .doc-preview { margin-top: 1.5rem; }
  .doc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--swal-surface);
    border: 1px solid var(--swal-border-light);
    color: var(--swal-accent-text);
    padding: 0.5rem 1rem;
    border-radius: 0;
    text-decoration: none;
    font-size: 0.875rem;
  }
  .doc-link:hover { background: var(--swal-surface-hover); text-decoration: underline; }
</style>
