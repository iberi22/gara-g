---
import FleetLayout from '../../../layouts/FleetLayout.astro';
import GenericTable from '../../../components/GenericTableAstro.astro';
import EntityForm from '../../../components/EntityForm.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { ensureSeedData, DEMO_INSTANCE_ID } from '../../../lib/fleetSeed.js';
import { listEntities } from '../../../lib/domain.js';
import { instanceIdFor } from '../../../garage/domain/tenant.js';
import { MARKET, documentKindLabel } from '../../../lib/market.js';
import { vehicleDisplayName } from '../../../lib/vehicleCatalog.js';

// Tenant de la sesion (fuera de produccion tambien admite ?instanceId=).
// La semilla solo se escribe para el tenant demo.
const instanceId = instanceIdFor(Astro.request, Astro.locals);
if (instanceId === DEMO_INSTANCE_ID) await ensureSeedData().catch(() => {});

const records = await listEntities('document', instanceId);
const vehicles = await listEntities('vehicle', instanceId);
const vehicleOptions = vehicles.map((v: any) => ({ value: v.id, label: `${v.plate || v.name || v.vin || `Sin ${MARKET.vehicleIdLabel.toLowerCase()}`} — ${vehicleDisplayName(v, MARKET)}` }));

// La tabla muestra la patente y el estado en español; lo guardado (id del vehículo, `valid`...) no cambia.
// El tipo de documento SÍ se traduce: las filas guardadas pueden decir 'SOAT' o 'Tecnomecánica'
// (vocabulario colombiano) y en Chile se leen SOAP y Revisión Técnica. El dato no se toca.
const STATUS_LABELS: Record<string, string> = { valid: 'Vigente', active: 'Vigente', expiring: 'Por vencer', expired: 'Vencido' };
const rows = records.map((r: any) => ({
  ...r,
  kind: documentKindLabel(r.kind, MARKET),
  vehicleLabel: (vehicles as any[]).find((v) => v.id === r.vehicleId)?.plate ?? r.vehicleId,
  statusLabel: STATUS_LABELS[r.status] ?? r.status,
}));

const columns = [
  { key: 'vehicleLabel', label: 'Vehículo' },
  { key: 'kind', label: 'Tipo' },
  { key: 'expiry', label: 'Vencimiento' },
  { key: 'statusLabel', label: 'Estado' },
];

const documentFields = [
  { name: 'vehicleId', label: 'Vehículo', type: 'select', required: true, options: vehicleOptions },
  { name: 'kind', label: 'Tipo de documento', type: 'text', required: true,
    placeholder: MARKET.documentTypesHint },
  { name: 'r2Key', label: 'R2 key (archivo)', type: 'text', placeholder: 'documents/GHI-202/archivo.pdf' },
  { name: 'expiry', label: 'Fecha de vencimiento', type: 'date' },
  {
    name: 'status', label: 'Estado', type: 'select',
    options: [
      { value: 'valid', label: 'Válido' },
      { value: 'expiring', label: 'Por vencer' },
      { value: 'expired', label: 'Vencido' },
    ],
  },
];
---

<FleetLayout title="Documentos" section="documents">
  <section data-testid="documents-page">
    <PageHeader
      title="Documentos"
      subtitle={MARKET.documentSubtitle}
      icon="documents"
    />

    <EntityForm
      entity="document"
      instanceId={instanceId}
      fields={documentFields}
      cancelUrl="/fleet/documents"
    />

    <GenericTable
      columns={columns}
      rows={rows}
      testId="documents-table"
      caption="Listado de documentos"
      actions={[
        { label: 'Ver archivo', href: (row: any) => `/r2/${row.r2Key}` },
        { label: 'Editar', href: (row: any) => `/fleet/documents/edit/${row.id}` },
      ]}
    />
  </section>
</FleetLayout>
