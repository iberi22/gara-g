---
/**
 * PrefsBootstrap — oculta los modulos y paneles desactivados ANTES de pintar (sin parpadeo).
 * Igual que ThemeBootstrap: lee localStorage y escribe una hoja de estilos para los
 * elementos con data-pref-module / data-pref-panel. Ver lib/swal-prefs/bootstrap.ts.
 */
import { prefsBootstrapScript } from '../../lib/swal-prefs/bootstrap';
import { PREFS_STORAGE_KEY } from '../../lib/prefs.config';
---

<script is:inline set:html={prefsBootstrapScript({ storageKey: PREFS_STORAGE_KEY })} />
