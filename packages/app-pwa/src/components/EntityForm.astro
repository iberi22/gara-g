---
/**
 * EntityForm.astro — Form HTML puro que crea/actualiza entidades via API.
 *
 * POST /api/fleet/{entity}     (create)
 * PATCH /api/fleet/{entity}    (update, requiere { id })
 *
 * Sin JavaScript cliente: el form envía JSON via fetch si JS habilitado,
 * o hace submit tradicional como fallback. Progressive enhancement.
 */

interface Field {
  name: string;
  label: string;
  type?: 'text' | 'number' | 'select' | 'textarea' | 'date' | 'checkbox' | 'tel';
  required?: boolean;
  options?: Array<{ value: string; label: string }>;
  placeholder?: string;
  step?: string;
  help?: string;
  fullWidth?: boolean;
}

interface Props {
  entity: 'vehicle' | 'driver' | 'maintenance' | 'document' | 'fleet' | 'fuelLog' | 'alert' | 'geofence';
  instanceId: string;
  fields: Field[];
  initialData?: Record<string, unknown>;
  cancelUrl?: string;
}

const { entity, instanceId, fields, initialData = {}, cancelUrl = `/fleet/${entity}s` } = Astro.props;
const isEdit = Boolean(initialData.id);
const formId = `form-${entity}-${isEdit ? (initialData.id as string) : 'new'}`;
const apiUrl = `/api/fleet/${entity}`;

function val(name: string): string | number {
  const v = (initialData as Record<string, unknown>)[name];
  if (v === null || v === undefined) return '';
  if (typeof v === 'number') return v;
  if (typeof v === 'string') return v;
  if (typeof v === 'object') return JSON.stringify(v);
  return String(v);
}
---

<form
  id={formId}
  class="g-form"
  data-entity={entity}
  data-instance={instanceId}
  data-api={apiUrl}
  data-mode={isEdit ? 'edit' : 'create'}
>
  {isEdit && <input type="hidden" name="id" value={initialData.id as string} />}

  <div class="g-form-grid">
    {fields.map((f) => {
      if (f.type === 'checkbox') {
        return (
          <div class="g-field g-field-checkbox" data-field={f.name}>
            <label for={`${formId}-${f.name}`} class="g-label-checkbox swal-kicker">
              <input
                id={`${formId}-${f.name}`}
                type="checkbox"
                name={f.name}
                class="g-checkbox"
                required={f.required}
                checked={Boolean(initialData[f.name])}
                data-testid={`input-${f.name}`}
              />
              <span>{f.label}</span>
              {f.required && <span class="g-required">*</span>}
            </label>
            {f.help && <small class="g-help">{f.help}</small>}
          </div>
        );
      }

      if (f.type === 'select') {
        const stored = String(val(f.name) ?? '');
        const covered = Boolean(f.options?.some((o) => String(o.value) === stored));
        return (
          <div class={`g-field ${f.fullWidth ? 'g-field-full' : ''}`} data-field={f.name}>
            <label for={`${formId}-${f.name}`} class="swal-kicker">
              {f.label}
              {f.required && <span class="g-required">*</span>}
            </label>
            <select
              id={`${formId}-${f.name}`}
              name={f.name}
              class="g-input g-select"
              required={f.required}
              data-testid={`input-${f.name}`}
            >
              <option value="">— Seleccionar —</option>
              {f.options?.map((o) => (
                <option value={o.value} selected={stored === String(o.value)}>
                  {o.label}
                </option>
              ))}
              {/* Valor guardado que las opciones actuales no ofrecen (p. ej. una clase de
                  licencia del otro mercado): con required el formulario quedaría imposible de
                  enviar. Se ofrece tal cual para poder conservarlo o cambiarlo. */}
              {stored !== '' && !covered && (
                <option value={stored} selected>
                  {stored} — valor guardado
                </option>
              )}
            </select>
            {f.help && <small class="g-help">{f.help}</small>}
          </div>
        );
      }

      if (f.type === 'textarea') {
        return (
          <div class="g-field g-field-full" data-field={f.name}>
            <label for={`${formId}-${f.name}`} class="swal-kicker">
              {f.label}
              {f.required && <span class="g-required">*</span>}
            </label>
            <textarea
              id={`${formId}-${f.name}`}
              name={f.name}
              class="g-input g-textarea"
              required={f.required}
              placeholder={f.placeholder}
              rows="3"
              data-testid={`input-${f.name}`}>{val(f.name)}</textarea>
            {f.help && <small class="g-help">{f.help}</small>}
          </div>
        );
      }

      return (
        <div class={`g-field ${f.fullWidth ? 'g-field-full' : ''}`} data-field={f.name}>
          <label for={`${formId}-${f.name}`} class="swal-kicker">
            {f.label}
            {f.required && <span class="g-required">*</span>}
          </label>
          <input
            id={`${formId}-${f.name}`}
            type={f.type ?? 'text'}
            name={f.name}
            class="g-input"
            required={f.required}
            placeholder={f.placeholder}
            step={f.step}
            value={val(f.name)}
            data-testid={`input-${f.name}`}
          />
          {f.help && <small class="g-help">{f.help}</small>}
        </div>
      );
    })}
  </div>

  <div class="g-form-actions">
    <a href={cancelUrl} class="g-btn g-btn-secondary">Cancelar</a>
    <button type="submit" class="g-btn g-btn-primary swal-chamfer-sm" data-testid={`${formId}-submit`}>
      {isEdit ? 'Actualizar' : 'Crear'}
    </button>
  </div>

  <div class="g-form-status" id={`${formId}-status-msg`} role="status" aria-live="polite" hidden></div>
</form>

<script>
  // Progressive enhancement: si JS habilitado, intercept submit y usa fetch.
  // Compatible con ViewTransitions (#951): re-vincula en cada astro:page-load,
  // con guard por formulario para no duplicar listeners en cargas completas.
  function bindEntityForms() {
  document.querySelectorAll<HTMLFormElement>('form.g-form:not([data-bound])').forEach((form) => {
    form.dataset.bound = '1';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const status = form.querySelector('.g-form-status') as HTMLElement;
      const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const entity = form.dataset.entity!;
      const instance = form.dataset.instance!;
      const api = form.dataset.api!;
      const mode = form.dataset.mode!;
      const cancelUrl = (form.querySelector('a[href]') as HTMLAnchorElement)?.href || '/';

      // Serializar
      const data: Record<string, unknown> = {};
      const formData = new FormData(form);

      form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((cb) => {
        data[cb.name] = cb.checked;
      });

      formData.forEach((v, k) => {
        if (form.querySelector<HTMLInputElement>(`input[name="${k}"][type="checkbox"]`)) return;
        if (k === 'id' && mode === 'edit') data[k] = v;
        else if (v !== '' && v !== null) data[k] = v;
      });

      if (mode === 'edit' && !data.id) {
        status.setAttribute('role', 'alert');
        status.textContent = 'Falta ID para editar';
        status.className = 'g-form-status g-error';
        status.hidden = false;
        return;
      }

      submit.disabled = true;
      status.setAttribute('role', 'status');
      status.textContent = mode === 'edit' ? 'Actualizando…' : 'Creando…';
      status.className = 'g-form-status g-loading';
      status.hidden = false;

      const method = mode === 'edit' ? 'PATCH' : 'POST';
      const url = mode === 'edit' ? `${api}?id=${data.id}&instanceId=${instance}` : `${api}?instanceId=${instance}`;

      try {
        const res = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'X-Instance-Id': instance,
          },
          body: JSON.stringify(data),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: res.statusText }));
          throw new Error(err.error || `HTTP ${res.status}`);
        }

        status.textContent = mode === 'edit' ? '✅ Actualizado' : '✅ Creado';
        status.className = 'g-form-status g-success';

        // Redirigir al listado
        setTimeout(() => {
          window.location.href = cancelUrl;
        }, 500);
      } catch (err) {
        // El rol cambia ANTES de escribir el texto: asi el error se anuncia de inmediato.
        status.setAttribute('role', 'alert');
        status.textContent = `❌ ${(err as Error).message}`;
        status.className = 'g-form-status g-error';
        submit.disabled = false;
      }
    });
  });
  } // bindEntityForms

  document.addEventListener('astro:page-load', bindEntityForms);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindEntityForms);
  } else {
    bindEntityForms();
  }
</script>

<style>
  .g-form {
    background: var(--swal-surface);
    border: 1px solid var(--swal-border);
    border-radius: 0;
    padding: 1.5rem;
    max-width: 56rem;
    box-sizing: border-box;
  }
  .g-form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem;
  }
  .g-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }
  .g-field-full {
    grid-column: 1 / -1;
  }
  .g-field-checkbox {
    grid-column: 1 / -1;
    justify-content: center;
  }
  .g-label-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
  }
  .g-checkbox {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--swal-accent);
    cursor: pointer;
  }
  .g-required {
    color: var(--swal-accent-text);
    margin-left: 0.25rem;
  }
  /* .g-input / .g-btn / .g-label / .g-btn-primary viven en gara-theme.css: aqui solo
     lo propio del formulario, con tokens. */
  .g-form .g-input {
    box-sizing: border-box;
    line-height: 1.5;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  input[type="date"].g-input {
    color-scheme: light;
  }
  :root[data-theme="taller-dark"] input[type="date"].g-input {
    color-scheme: dark;
  }
  select.g-input option {
    background-color: var(--swal-bg-elevated);
    color: var(--swal-text);
  }
  .g-input:focus {
    box-shadow: 0 0 0 1px var(--g-focus-ring);
  }
  .g-input:invalid:not(:placeholder-shown) {
    border-color: var(--swal-danger);
  }
  .g-textarea {
    resize: vertical;
    min-height: 4.5rem;
  }
  .g-help {
    font-size: 0.75rem;
    color: var(--swal-text-muted);
    margin-top: 0.125rem;
    line-height: 1.3;
  }
  .g-form-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--swal-border-light);
  }
  .g-form-actions .g-btn {
    justify-content: center;
  }
  .g-btn-secondary {
    background: transparent;
    border-color: transparent;
    color: var(--swal-text-muted);
  }
  .g-btn-secondary:hover {
    background: var(--swal-hover-bg);
    color: var(--swal-text);
  }
  .g-btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .g-form-status {
    margin-top: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .g-loading { background: var(--swal-bg-elevated); color: var(--swal-text-muted); }
  .g-success { background: var(--swal-success-muted); color: var(--swal-success); border: 1px solid color-mix(in srgb, var(--swal-success) 35%, transparent); }
  .g-error { background: var(--swal-danger-muted); color: var(--swal-danger); border: 1px solid color-mix(in srgb, var(--swal-danger) 35%, transparent); }
</style>
