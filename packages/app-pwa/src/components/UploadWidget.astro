---
/**
 * UploadWidget.astro — Form HTML para subir archivos a R2 vía /api/fleet/files.
 *
 * Subida: form action="/api/fleet/files" method="post" enctype="multipart/form-data".
 * Después del upload: el server redirige (303) a la misma página con ?uploaded=key.
 * Delete: form action con _method=DELETE → handler del endpoint files.
 */
interface UploadedFile {
  id: string;
  key: string;
  name: string;
  type?: string;
  size?: number;
  kind?: string;
}

interface Props {
  entityType: string;
  entityId: string;
  kind: string;
  label: string;
  initialFiles?: UploadedFile[];
  backUrl: string;
}

const { entityType, entityId, kind, label, initialFiles = [], backUrl } = Astro.props as Props;
const uploaded = Astro.url.searchParams.get('uploaded');
const error = Astro.url.searchParams.get('error');

function formatSize(bytes?: number): string {
  if (!bytes) return '?';
  if (bytes < 1024) return `${bytes}B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)}KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)}MB`;
}
---

<details class="upload-widget" open>
  <summary>
    <strong>{label}</strong>
    <span class="upload-count">{initialFiles.length} archivo{initialFiles.length !== 1 ? 's' : ''}</span>
  </summary>

  <div class="upload-body">
    {uploaded && (
      <div class="upload-toast upload-toast-ok">
        ✓ Archivo subido: <code>{uploaded.split('/').pop()}</code>
      </div>
    )}
    {error && (
      <div class="upload-toast upload-toast-err">
        ✗ Error: {error}
      </div>
    )}

    <form
      method="post"
      action="/api/fleet/files"
      enctype="multipart/form-data"
      class="upload-form"
      data-back-url={backUrl}
    >
      <input type="hidden" name="entityType" value={entityType} />
      <input type="hidden" name="entityId" value={entityId} />
      <input type="hidden" name="kind" value={kind} />
      <input type="hidden" name="_redirect" value={backUrl} />

      <div class="upload-input-row">
        <label class="upload-file-label">
          <input
            type="file"
            name="file"
            required
            accept="image/jpeg,image/png,image/webp,image/gif,application/pdf"
            class="upload-file-input"
            data-original-text="Ningún archivo seleccionado"
          />
          <span class="upload-file-button">📎 Elegir archivo</span>
          <span class="upload-file-name">Ningún archivo seleccionado</span>
        </label>
        <button type="submit" class="upload-submit">Subir</button>
      </div>

      <p class="upload-help">Máx 10MB. Formatos: JPEG, PNG, WebP, GIF, PDF</p>
    </form>

    {initialFiles.length > 0 && (
      <ul class="upload-list">
        {initialFiles.map((f) => (
          <li class="upload-item">
            <a href={`/r2/${f.key}`} target="_blank" rel="noopener" class="upload-item-link">
              {f.type?.startsWith('image/') ? '🖼️' : '📄'} {f.name}
            </a>
            <span class="upload-item-meta">{formatSize(f.size)}</span>
            <form
              method="post"
              action="/api/fleet/files"
              class="upload-item-delete-form"
              onsubmit={`return confirm('¿Eliminar ${f.name.replace(/'/g, "\\'")}?')`}
            >
              <input type="hidden" name="_method" value="DELETE" />
              <input type="hidden" name="key" value={f.key} />
              <input type="hidden" name="_redirect" value={backUrl} />
              <button type="submit" class="upload-item-delete" title="Eliminar">✗</button>
            </form>
          </li>
        ))}
      </ul>
    )}
  </div>
</details>

<style>
  .upload-widget {
    border: 1px dashed var(--swal-border-strong);
    border-radius: 0;
    padding: 0.75rem 1rem;
    margin: 1rem 0;
    background: transparent;
    transition: all 0.2s;
  }
  .upload-widget:hover {
    border-color: var(--swal-accent);
    background: var(--swal-accent-muted);
  }
  .upload-widget summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }
  .upload-widget summary::-webkit-details-marker { display: none; }
  .upload-widget summary::before { content: '📁'; font-size: 1.1rem; }
  .upload-count {
    color: var(--swal-text-muted);
    font-size: 0.875rem;
    font-family: var(--swal-font-mono);
  }
  .upload-body { padding-top: 0.75rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .upload-toast { padding: 0.5rem 0.75rem; border-radius: 0; font-size: 0.875rem; }
  .upload-toast-ok { background: var(--swal-success-muted); border: 1px solid color-mix(in srgb, var(--swal-success) 35%, transparent); color: var(--swal-success); }
  .upload-toast-err { background: var(--swal-danger-muted); border: 1px solid color-mix(in srgb, var(--swal-danger) 35%, transparent); color: var(--swal-danger); }
  .upload-form { display: flex; flex-direction: column; gap: 0.375rem; }
  .upload-input-row { display: flex; gap: 0.5rem; align-items: center; }
  .upload-file-label { flex: 1; display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
  .upload-file-input {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .upload-file-button {
    background: transparent; border: 1px solid var(--swal-border);
    color: var(--swal-text); padding: 0.375rem 0.75rem; border-radius: 0;
    font-size: 0.875rem; font-family: inherit; cursor: pointer; transition: background 0.15s;
  }
  .upload-file-button:hover { background: var(--swal-hover-bg); }
  .upload-file-name { color: var(--swal-text-muted); font-size: 0.875rem; font-family: var(--swal-font-mono); }
  .upload-submit {
    background: var(--swal-accent); color: var(--swal-accent-contrast); border: 0;
    padding: 0.375rem 1rem; border-radius: 0; font-size: 0.875rem;
    font-family: inherit; cursor: pointer;
  }
  .upload-submit:hover { background: var(--swal-accent-hover); }
  .upload-submit:disabled { opacity: 0.6; cursor: not-allowed; }
  .upload-help { margin: 0; color: var(--swal-text-muted); font-size: 0.75rem; }
  .upload-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .upload-item {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.375rem 0.5rem; background: var(--swal-surface); border-radius: 0;
  }
  .upload-item-link {
    flex: 1; color: var(--swal-text); text-decoration: none; font-size: 0.875rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .upload-item-link:hover { color: var(--swal-accent-text); text-decoration: underline; }
  .upload-item-meta { color: var(--swal-text-muted); font-size: 0.75rem; font-family: var(--swal-font-mono); }
  .upload-item-delete-form { margin: 0; }
  .upload-item-delete {
    background: transparent; border: 1px solid color-mix(in srgb, var(--swal-danger) 35%, transparent); color: var(--swal-danger);
    border-radius: 0; width: 1.5rem; height: 1.5rem; cursor: pointer;
    font-size: 0.875rem; line-height: 1; padding: 0;
  }
  .upload-item-delete:hover { background: var(--swal-danger-muted); }
</style>

<script>
  // Show selected filename
  //
  // SPA-safe (ViewTransitions): este es un script de modulo, se ejecuta una vez.
  // Con el ClientRouter los nodos se sustituyen al navegar, así que el input
  // nuevo quedaba sin listener y el nombre del fichero no se actualizaba
  // después de la primera navegación. El guard evita duplicarlo en el mismo DOM.
  function initUploadLabels() {
    document.querySelectorAll('.upload-form:not([data-bound])').forEach((form) => {
      form.setAttribute('data-bound', '1');
      // Envio unico: el POST es una navegacion completa y tarda; sin esto un segundo clic
      // sube el fichero dos veces. El boton se deshabilita DESPUES de que arranque el envio.
      form.addEventListener('submit', (e) => {
        const f = e.currentTarget as HTMLFormElement;
        if (f.dataset.submitting === '1') {
          e.preventDefault();
          return;
        }
        f.dataset.submitting = '1';
        const btn = f.querySelector('.upload-submit') as HTMLButtonElement | null;
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Subiendo…';
        }
      });
    });
    document.querySelectorAll('.upload-file-input:not([data-bound])').forEach((input) => {
      input.setAttribute('data-bound', '1');
      input.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const name = target.files?.[0]?.name;
        const span = target.parentElement?.querySelector('.upload-file-name') as HTMLElement | null;
        if (span && name) span.textContent = name;
      });
    });
  }

  // Volver con el boton "atras" (bfcache) restaura la pagina con el boton ya deshabilitado.
  window.addEventListener('pageshow', (e) => {
    if (!(e as PageTransitionEvent).persisted) return;
    document.querySelectorAll('.upload-form').forEach((form) => {
      (form as HTMLFormElement).dataset.submitting = '';
      const btn = form.querySelector('.upload-submit') as HTMLButtonElement | null;
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Subir';
      }
    });
  });

  document.addEventListener('astro:page-load', initUploadLabels);
  initUploadLabels();
</script>
