---
import themeBootstrapScript from '../../lib/inline/theme-bootstrap.js?raw';
/**
 * ThemeBootstrap — aplica el tema de @swal/ui ANTES de pintar (sin parpadeo).
 *
 * Preferencia del usuario (localStorage `swal:theme-mode`): 'light' | 'dark' | 'system'.
 * Se resuelve a `data-theme` en <html>: "taller" (claro) o "taller-dark" (oscuro).
 * Sin preferencia guardada manda el claro: el taller es la cara del sistema.
 *
 * API global para los selectores (ThemeModeSwitch, el HUD del garage):
 *   window.swalTheme.get()          → 'light' | 'dark' | 'system'
 *   window.swalTheme.set(mode)      → guarda y aplica
 *   window.swalTheme.resolved()     → 'light' | 'dark' (lo que se ve)
 *   evento `swal:themechange` en document, detail { mode, resolved }
 *
 * Con el ClientRouter de Astro, cada navegacion reemplaza los atributos de <html> por los
 * de la pagina nueva: por eso se reaplica en `astro:after-swap`.
 */
---

<script is:inline set:html={themeBootstrapScript} />
