---
/**
 * PageHeader.astro — Header reutilizable para todas las páginas fleet.
 * Aplica automáticamente las clases del theme global (.g-page-header, .g-page-title).
 *
 * Uso:
 *   <PageHeader title="Vehículos" subtitle="Parque automotor">
 *     <FleetIcon name="vehicles" slot="icon" />
 *   </PageHeader>
 */
import FleetIcon from './FleetIcon.astro';

interface Props {
  title: string;
  subtitle?: string;
  icon?: string;
  count?: number;
  countLabel?: string;
}

const { title, subtitle, icon, count, countLabel = 'registros' } = Astro.props;
---

<header class="g-page-header" data-testid="page-header">
  <div class="g-page-header-left">
    {icon && (
      <span class="g-page-icon" aria-hidden="true">
        <span class="g-page-icon-inner">
          <FleetIcon name={icon} size={22} />
        </span>
      </span>
    )}
    <div class="g-page-titles">
      <h2 class="g-page-title">{title}</h2>
      {subtitle && <p class="g-page-subtitle swal-kicker">{subtitle}</p>}
    </div>
  </div>
  {count !== undefined && (
    <span class="g-pill g-pill-cyan" data-testid="page-header-count">
      <FleetIcon name="dashboard" size={12} />
      {count} {countLabel}
    </span>
  )}
  <slot />
</header>

<style>
  .g-page-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  /* Icono en caja con esquinas cortadas: el marco es el borde de 1px (un `border`
     normal desapareceria en las esquinas cortadas) y el interior la superficie. */
  .g-page-icon {
    width: 38px;
    height: 38px;
    padding: 1px;
    display: block;
    flex-shrink: 0;
    background: var(--swal-border-strong);
    clip-path: polygon(var(--swal-chamfer-sm) 0, 100% 0, 100% calc(100% - var(--swal-chamfer-sm)), calc(100% - var(--swal-chamfer-sm)) 100%, 0 100%, 0 var(--swal-chamfer-sm));
  }
  .g-page-icon-inner {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: var(--swal-surface);
    color: var(--swal-accent-text);
    clip-path: inherit;
  }
  .g-page-titles {
    min-width: 0;
  }
  .g-page-title {
    color: var(--swal-text);
  }
  /* El rotulo (.swal-kicker) ya trae mono/mayusculas/color; aqui solo el aire. */
  .g-page-subtitle {
    margin: 0.25rem 0 0;
  }
</style>