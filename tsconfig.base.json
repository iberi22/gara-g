{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@gara-g/*": ["packages/*/src"]
    }
  },
  "exclude": ["node_modules", ".turbo", "dist", "build", "lib"]
}
